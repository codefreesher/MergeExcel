QWidget { color: #182135; font-family: "Inter", "Segoe UI", "Noto Sans"; font-size: 13px; }
QMainWindow, QWidget#content, QStackedWidget, QStackedWidget > QWidget { background-color: #f7f9fc; }
QDialog, QMessageBox { background-color: #ffffff; color: #182135; }
QDialog QLabel, QMessageBox QLabel { background-color: transparent; color: #182135; }
QMessageBox QPushButton { min-width: 86px; background-color: #ffffff; color: #182135; }
QScrollArea, QScrollArea > QWidget > QWidget, QScrollArea QWidget#scrollBody { background-color: #f7f9fc; }
QScrollArea::viewport { background-color: #f7f9fc; }
#sidebar { background-color: #ffffff; border-right: 1px solid #e3e8ef; }
#brand { font-size: 17px; font-weight: 700; color: #182135; }
QPushButton { border: 1px solid #d7dee9; border-radius: 6px; padding: 7px 13px; background-color: #ffffff; }
QPushButton:hover { border-color: #2f6fed; background: #f5f8ff; }
QPushButton:disabled { color: #9aa4b2; background: #eef1f5; border-color: #e1e5ea; }
QPushButton#primary { background-color: #1769e8; color: white; border: 0; font-weight: 600; padding: 10px 18px; }
QPushButton#primary:hover { background: #1758dc; }
QPushButton#danger { color: #c93636; }
QPushButton#nav { text-align: left; border: 0; padding: 10px 12px; background-color: transparent; color: #536075; }
QPushButton#nav:checked { color: #1769e8; background-color: #eaf2ff; font-weight: 600; }
QFrame#card { background-color: #ffffff; border: 1px solid #dde4ed; border-radius: 9px; }
QLabel#pageTitle { font-size: 20px; font-weight: 700; color: #141c2d; }
QLabel#sectionTitle { font-size: 14px; font-weight: 600; background: transparent; border: 0; }
QLabel#stepBadge { min-width: 22px; max-width: 22px; min-height: 22px; max-height: 22px; border-radius: 11px; background-color: #1769e8; color: white; font-weight: 700; }
QLineEdit, QComboBox { border: 1px solid #ccd3df; border-radius: 6px; padding: 8px; background: white; }
QLineEdit:focus { border-color: #246bfd; }
QTableWidget { background-color: white; alternate-background-color: #fbfcfe; border: 1px solid #e1e6ee; border-radius: 7px; gridline-color: #edf0f5; selection-background-color: #eaf2ff; selection-color: #172033; }
QHeaderView { background-color: #f7f9fc; color: #182135; }
QHeaderView::section { background-color: #f7f9fc; color: #182135; border: 0; border-right: 1px solid #edf0f5; border-bottom: 1px solid #e1e6ee; padding: 8px; font-weight: 600; }
QHeaderView::section:vertical { background-color: #f7f9fc; color: #536075; }
QTableCornerButton::section { background-color: #f7f9fc; border: 0; border-right: 1px solid #e1e6ee; border-bottom: 1px solid #e1e6ee; }
QProgressBar { border: 0; border-radius: 4px; background: #e8edf5; text-align: center; }
QProgressBar::chunk { background: #246bfd; border-radius: 4px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #aeb9c8; border-radius: 3px; background-color: #ffffff; }
QCheckBox::indicator:checked { background-color: #1769e8; border-color: #1769e8; image: url(app/resources/icons/check.svg); }
QScrollArea { border: 0; background-color: #f7f9fc; }
