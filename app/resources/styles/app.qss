QWidget { color: #172033; font-family: "Segoe UI"; font-size: 13px; }
QMainWindow, #content { background: #f5f7fb; }
#sidebar { background: #ffffff; border-right: 1px solid #e5e9f0; }
#brand { font-size: 18px; font-weight: 700; color: #172033; }
QPushButton { border: 1px solid #d8dee9; border-radius: 7px; padding: 8px 14px; background: #ffffff; }
QPushButton:hover { border-color: #2f6fed; background: #f5f8ff; }
QPushButton:disabled { color: #9aa4b2; background: #eef1f5; border-color: #e1e5ea; }
QPushButton#primary { background: #246bfd; color: white; border: 0; font-weight: 600; padding: 11px 18px; }
QPushButton#primary:hover { background: #1758dc; }
QPushButton#danger { color: #c93636; }
QPushButton#nav { text-align: left; border: 0; padding: 11px 14px; background: transparent; color: #556176; }
QPushButton#nav:checked { color: #185bd8; background: #edf4ff; font-weight: 600; }
QFrame#card { background: #ffffff; border: 1px solid #e3e7ee; border-radius: 10px; }
QLabel#pageTitle { font-size: 21px; font-weight: 700; }
QLabel#sectionTitle { font-size: 15px; font-weight: 600; }
QLineEdit, QComboBox { border: 1px solid #ccd3df; border-radius: 6px; padding: 8px; background: white; }
QLineEdit:focus { border-color: #246bfd; }
QTableWidget { background: white; border: 1px solid #e1e6ee; border-radius: 7px; gridline-color: #edf0f5; selection-background-color: #eaf2ff; selection-color: #172033; }
QHeaderView::section { background: #f7f9fc; border: 0; border-bottom: 1px solid #e1e6ee; padding: 8px; font-weight: 600; }
QProgressBar { border: 0; border-radius: 4px; background: #e8edf5; text-align: center; }
QProgressBar::chunk { background: #246bfd; border-radius: 4px; }
QCheckBox { spacing: 8px; }
QScrollArea { border: 0; background: transparent; }

